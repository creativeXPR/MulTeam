{
  "name": "multeam",
  "version": "1.0.0",
  "description": "Multi-user real-time collaborative code editor built on Electron, Monaco, Yjs and Firebase.",
  "main": "src/main/index.js",
  "scripts": {
    "build:renderer": "node build/bundle.js",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "dist": "npm run build:renderer && electron-builder",
    "test": "node --test tests/**/*.test.js",
    "test:emulator": "firebase emulators:exec --project demo-multeam --only database \"node tests/emulator/liveSync.mjs\"",
    "test:live-project": "firebase emulators:exec --project demo-multeam --only database \"node tests/emulator/liveProject.mjs\"",
    "test:sessions": "firebase emulators:exec --project demo-multeam --only database \"node tests/emulator/sessions.mjs\"",
    "test:live-ui": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"electron tests/emulator/liveProjectUi.cjs\"",
    "test:github-ui": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"electron tests/emulator/githubUi.cjs\"",
    "test:cursors-ui": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"electron tests/emulator/cursorsUi.cjs\"",
    "test:teams-ui": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"electron tests/emulator/teamsUi.cjs\"",
    "test:members": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"node tests/emulator/members.mjs\"",
    "test:collab-ui": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"electron tests/emulator/collabUi.cjs\"",
    "icons": "electron build/make-icons.js",
    "test:sessions-ui": "firebase emulators:exec --project demo-multeam --only auth,firestore,functions,database \"electron tests/emulator/sessionsUi.cjs\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "electron": "^44.1.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "firebase": "^10.13.0",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.1.0",
    "simple-git": "^4.0.2",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  }
}
