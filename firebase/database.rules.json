{
  "rules": {
    ".read": false,
    ".write": false,

    "projectMembers": {
      "$projectId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": "auth != null && (data.child(auth.uid).val() === 'owner' || (!data.exists() && newData.child(auth.uid).val() === 'owner'))",
        "$uid": {
          ".validate": "newData.val() === 'owner' || newData.val() === 'editor' || newData.val() === 'viewer'"
        }
      }
    },

    "projects": {
      "$projectId": {
        ".write": "auth != null && !newData.exists() && root.child('projectMembers').child($projectId).child(auth.uid).val() === 'owner'",

        "b": {
          "$branch": {
            ".read": "auth != null && root.child('projectMembers').child($projectId).child(auth.uid).exists()",

            "docs": {
              "$fileKey": {
                ".write": "auth != null && !newData.exists() && (root.child('projectMembers').child($projectId).child(auth.uid).val() === 'owner' || root.child('projectMembers').child($projectId).child(auth.uid).val() === 'editor')",

                "updates": {
                  "$pushId": {
                    ".write": "auth != null && (root.child('projectMembers').child($projectId).child(auth.uid).val() === 'owner' || root.child('projectMembers').child($projectId).child(auth.uid).val() === 'editor') && (!data.exists() || !newData.exists())",
                    ".validate": "newData.hasChildren(['state', 'origin']) && newData.child('state').isString() && newData.child('state').val().length <= 1000000 && newData.child('origin').isNumber()"
                  }
                },

                "snapshot": {
                  ".write": "auth != null && (root.child('projectMembers').child($projectId).child(auth.uid).val() === 'owner' || root.child('projectMembers').child($projectId).child(auth.uid).val() === 'editor')",
                  ".validate": "newData.hasChildren(['state', 'updatedAt']) && newData.child('state').isString()"
                },

                "awareness": {
                  "$clientId": {
                    ".write": "auth != null && root.child('projectMembers').child($projectId).child(auth.uid).exists()",
                    ".validate": "newData.isString() && newData.val().length <= 20000"
                  }
                }
              }
            },

            "files": {
              "$fileKey": {
                ".write": "auth != null && (root.child('projectMembers').child($projectId).child(auth.uid).val() === 'owner' || root.child('projectMembers').child($projectId).child(auth.uid).val() === 'editor')",
                ".validate": "newData.hasChildren(['path', 'kind', 'state', 'by', 'at']) && newData.child('path').isString() && newData.child('path').val().length <= 1000 && (newData.child('kind').val() === 'file' || newData.child('kind').val() === 'dir') && (newData.child('state').val() === 'live' || newData.child('state').val() === 'deleted') && newData.child('by').val() === auth.uid && newData.child('at').isNumber()"
              }
            }
          }
        }
      }
    }
  }
}
