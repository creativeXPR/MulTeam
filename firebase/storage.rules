rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Not yet used by the app (files are edited on local disk, not uploaded)
    // but reserved for user avatars / project asset uploads on the roadmap.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
