rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() { return request.auth != null; }

    // Cloud projects: projects/{projectId} with members.{uid}.role and
    // memberUids (for "projects I'm in" queries). Membership changes go
    // through the Cloud Functions in functions/index.js (admin SDK), which
    // also mirror roles into RTDB projectMembers/ for live editing.
    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function isOwnerOf(projectId) {
      return signedIn() && projectData(projectId).members[request.auth.uid].role == 'owner';
    }
    function isMemberOf(projectId) {
      return signedIn() && request.auth.uid in projectData(projectId).memberUids;
    }
    function myEmail() { return request.auth.token.email.lower(); }

    // Profiles: your own only. Other users are found through the
    // searchUsers function, which returns names/photos but never emails.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && (!('emailLower' in request.resource.data) || request.resource.data.emailLower == myEmail())
        && (!('nameLower' in request.resource.data) || request.resource.data.nameLower is string);

      // Legacy location of cloud projects (before members/invites). Owners
      // can still read + delete theirs while the app moves them to /projects.
      match /projects/{projectId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /projects/{projectId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      // created by its owner, with only themselves as a member
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner'
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      // the owner may rename it / set its repo; membership is functions-only
      allow update: if signedIn() && resource.data.members[request.auth.uid].role == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'repoUrl', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow delete: if signedIn() && resource.data.members[request.auth.uid].role == 'owner';

      // "needs approval" link joins; written by functions only
      match /joinRequests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwnerOf(projectId));
        allow delete: if signedIn() && (request.auth.uid == uid || isOwnerOf(projectId));
        allow create, update: if false;
      }
    }

    // Email invites: created by the project owner; read by the owner or the
    // invitee (matching, verified email). Accept/decline via functions.
    match /invites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isOwnerOf(request.resource.data.projectId)
        && request.resource.data.invitedBy.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+$')
        && request.resource.data.email != myEmail();
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || resource.data.inviteeUid == request.auth.uid
        || (request.auth.token.email_verified == true && resource.data.email == myEmail()));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    // Invite links / codes: owner-only; redeemed via the redeemCode function.
    match /inviteLinks/{code} {
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.ownerId == request.auth.uid
        && isOwnerOf(request.resource.data.projectId)
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.requiresApproval is bool
        && request.resource.data.revoked == false;
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']);
    }

    match /documents/{docId} {
      allow read, write: if isMemberOf(resource.data.projectId);
      allow create: if isMemberOf(request.resource.data.projectId);
    }

    // ---------- Plugin gallery (renderer/js/firebase.js → gallery*) ----------
    // Anyone may browse. Signed-in users publish; the first publisher of an
    // id owns it. Versions are immutable. Anyone may bump the download
    // counter by exactly one.
    function validListing(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.authorName is string && d.authorName.size() <= 80
        && d.latestVersion is string && d.latestVersion.size() > 0 && d.latestVersion.size() <= 40
        && d.permissions is list && d.permissions.size() <= 3
        && d.size is int && d.size > 0 && d.size <= 716800
        && d.downloads is int && d.downloads >= 0;
    }

    match /pluginGallery/{pluginId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && pluginId.matches('^[a-z0-9][a-z0-9-]{1,63}$')
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.downloads == 0
        && validListing(request.resource.data);

      allow update: if isAuthenticated() && (
        // the owner publishing a new version (counter and owner unchanged)
        (resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.downloads == resource.data.downloads
          && validListing(request.resource.data))
        // anyone: download counter +1, nothing else
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
          && request.resource.data.downloads == resource.data.downloads + 1)
      );

      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;

      match /versions/{version} {
        allow read: if true;

        // getAfter: the listing may be created in the same batch
        allow create: if isAuthenticated()
          && getAfter(/databases/$(database)/documents/pluginGallery/$(pluginId)).data.authorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/pluginGallery/$(pluginId)).data.latestVersion == version
          && request.resource.data.version == version
          && request.resource.data.package is string && request.resource.data.package.size() > 0 && request.resource.data.package.size() <= 960000
          && request.resource.data.sha256 is string && request.resource.data.sha256.matches('^[0-9a-f]{64}$')
          && request.resource.data.size is int && request.resource.data.size <= 716800;

        allow update: if false;
        allow delete: if isAuthenticated()
          && get(/databases/$(database)/documents/pluginGallery/$(pluginId)).data.authorUid == request.auth.uid;
      }
    }
  }
}
